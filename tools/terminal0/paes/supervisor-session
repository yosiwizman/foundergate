#!/usr/bin/env node
// PAES-1 USER_SESSION_DETACHED supervisor — persistent loop for a process
// launched from the authenticated user session (NOT launchd). Detaches from its
// parent shell, closes stdin, writes durable heartbeat/lease/state, and re-invokes
// the narrow-allowlist unattended executor until deadline / PANIC / exhaustion.
// Auth works because this inherits the login session's keychain access.
import { spawn } from "node:child_process";
import { readFileSync, writeFileSync, existsSync, mkdirSync, appendFileSync, renameSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import { canEnterRunning, evaluateStop, deadlineStatus } from "../../../src/supervisor/supervisor-core.mjs";
import { acquireSingleton, releaseSingleton } from "../../../src/supervisor/singleton.mjs";
import { runBeatingChild } from "../../../src/supervisor/worker-heartbeat.mjs";
import { originalRunDeadline, workerSpawnDecision, isDoneOutcome, shouldStopScheduling } from "../../../src/supervisor/deadline-law.mjs";
import { readFileSync as _rf, existsSync as _ex } from "node:fs";

const REPO = join(dirname(fileURLToPath(import.meta.url)), "..", "..", "..");
// SUP defaults to the real supervisor dir; FG_SUP_DIR lets tests point the real
// production supervisor at an isolated synthetic state root (no real state touched).
const SUP = process.env.FG_SUP_DIR || join(REPO, ".foundergate", "supervisor");
const CLAUDE = process.env.FG_CLAUDE_BIN || "claude";
// Each tool is a SEPARATE argv element — several Bash patterns contain an
// internal space (e.g. "Bash(git add:*)"), so a single space-joined string
// would be mis-split by the CLI. Pass them individually to --allowedTools.
const ALLOWLIST = ["Read", "Edit", "Write", "Grep", "Glob",
  "Bash(git add:*)", "Bash(git commit:*)", "Bash(git status:*)", "Bash(git diff:*)",
  "Bash(node scripts/run-selftests.mjs)"];
const CYCLE_SLEEP_MS = Number(process.env.FG_CYCLE_SLEEP_MS || 8000);
const HEARTBEAT_INTERVAL_MS = Number(process.env.FG_HEARTBEAT_INTERVAL_MS || 1000);
const WARMUP_BEATS = Number(process.env.FG_WARMUP_BEATS || 5);
// Drain margin: stop taking NEW work this many seconds before the deadline. The
// HARD deadline law (per-worker effective timeout) is independent of and stronger
// than this; the margin only affects when draining begins. Configurable so
// deadline-during-worker behaviour is testable without a 15-minute wait.
const DRAIN_MARGIN_S = Number(process.env.FG_DRAIN_MARGIN_S || 900);
let hbSeq = 0;
// WAVE2 observability: stamp every emitted event with the active run_id so the
// founder status can scope the timeline by run (legacy unscoped events read as
// historical). Additive metadata only — does not change any runtime behaviour.
let RUN_ID = null;
const MAX_CYCLES = Number(process.env.FG_MAX_CYCLES || 0); // 0 = until deadline

const LOCK = join(SUP, "singleton.lock");
const nowS = () => Math.floor(Date.now() / 1000);
const rj = (p, d) => { const f = join(SUP, p); return existsSync(f) ? JSON.parse(readFileSync(f, "utf8")) : d; };
const wj = (p, o) => { const f = join(SUP, p); const t = f + ".tmp"; writeFileSync(t, JSON.stringify(o, null, 2) + "\n"); renameSync(t, f); };
const led = (e) => appendFileSync(join(SUP, "events.jsonl"), JSON.stringify({ ...e, run_id: RUN_ID, ts: nowS() }) + "\n");
// Heartbeat also refreshes the singleton lock's last_heartbeat so staleness works.
const beat = () => {
  // ms resolution + a strictly-increasing seq so consecutive beats are always
  // distinct/advancing (seconds-resolution ts collides for sub-second beats).
  hbSeq += 1;
  wj("heartbeat.json", { ts: Date.now(), seq: hbSeq, pid: process.pid, mode: "USER_SESSION_DETACHED" });
  // Atomic (temp+rename) so a crash mid-beat cannot truncate/corrupt the lock.
  try { const l = JSON.parse(_rf(LOCK, "utf8")); if (l.pid === process.pid) { l.last_heartbeat = nowS(); const t = LOCK + ".tmp"; writeFileSync(t, JSON.stringify(l, null, 2) + "\n"); renameSync(t, LOCK); } } catch { /* */ }
};
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function preconditions() {
  const gov = (p) => { try { return JSON.parse(readFileSync(join(REPO, ".foundergate/governance", p), "utf8")).status === "ACTIVE"; } catch { return false; } };
  return {
    dcl_capture_verified: existsSync(join(SUP, "..", "directives", "paes-session-1", "prompt.txt")),
    are_manifest_verified: gov("autonomous_run_envelope.json"), arlc_active: gov("autonomous_repository_lifecycle.json"),
    tbf_active: existsSync(join(REPO, ".foundergate/policies/test_before_founder.json")),
    unattended_executor_proven: true, user_level_service_installed: true, one_writer_lock_available: true,
    deadline_not_passed: nowS() < (rj("current-cycle.json", {}).deadline || Infinity),
    panic_not_active: !rj("stop.json", {}).panic_stop,
    authorized_job_exists: (rj("queue.json", { jobs: [] }).jobs || []).some((j) => j.state === "READY"),
  };
}

// The IMMUTABLE original run deadline (epoch seconds): the ORC recovery
// checkpoint's original_deadline (survives restart/recovery) or, absent that, the
// cycle deadline. Missing/malformed -> null so the deadline law fails closed.
function originalDeadlineS() {
  // SUP-relative recovery path: identical to REPO/.foundergate/recovery in
  // production, isolated under FG_SUP_DIR for tests.
  const cp = join(SUP, "..", "recovery", "checkpoint.json");
  const checkpoint = existsSync(cp)
    ? (() => { try { return JSON.parse(readFileSync(cp, "utf8")); } catch { return null; } })() : null;
  const cycle = rj("current-cycle.json", null);
  return originalRunDeadline({ checkpoint, cycle });
}
// Optional authorized per-job timeout (seconds). Env/queue can only SHORTEN the
// window (the deadline law caps it by remaining run time); they can never enlarge it.
function jobTimeoutS(job) {
  const q = Number(job && job.timeout_s);
  const e = Number(process.env.FG_JOB_TIMEOUT_S);
  const cands = [q, e].filter((n) => Number.isFinite(n) && n > 0);
  return cands.length ? Math.min(...cands) : null;
}

async function runWorker(job) {
  // HARD DEADLINE LAW: compute remaining run time and the effective (capped)
  // timeout for THIS invocation. If the deadline has passed, never spawn.
  const decision = workerSpawnDecision({ originalDeadlineS: originalDeadlineS(), nowS: nowS(), jobTimeoutS: jobTimeoutS(job) });
  if (!decision.spawn) {
    led({ evt: "worker_not_spawned", job_id: job.job_id, outcome: decision.outcome, reason: "run deadline expired before spawn" });
    return { outcome: decision.outcome, ok: false, preSpawn: true, spawned: false };
  }
  const pf = join(SUP, "worker-results", `${job.job_id}.prompt.txt`);
  const prompt = existsSync(pf) ? readFileSync(pf, "utf8") : (job.prompt || 'Return {"noop":true}');
  const sess = rj(`worker-results/${job.job_id}.session`, null);
  // --allowedTools is VARIADIC and greedily consumes following args, so the
  // prompt must come right after -p and --allowedTools must be LAST.
  const tail = ["--output-format", "json", "--allowedTools", ...ALLOWLIST];
  const args = sess && sess.session_id
    ? ["--resume", sess.session_id, "-p", prompt, ...tail]
    : ["-p", prompt, ...tail];
  led({ evt: "worker_invocation", job_id: job.job_id, mode: sess ? "resume" : "fresh", effective_timeout_s: decision.effectiveTimeoutS, timeout_outcome: decision.timeoutOutcome });
  // NON-BLOCKING spawn in its OWN PROCESS GROUP (detached) + heartbeat interval:
  // liveness stays fresh for the whole worker, AND the effective timeout is a HARD
  // execution boundary — on timeout/stop the whole process tree is SIGTERM->grace
  // ->SIGKILL'd and VERIFIED gone. A timeout is never marked SUCCESS/DONE.
  const r = await runBeatingChild({
    spawnChild: () => spawn(CLAUDE, args, { cwd: REPO, stdio: ["ignore", "pipe", "pipe"], detached: true }),
    beat, intervalMs: HEARTBEAT_INTERVAL_MS, maxBufferBytes: 64 * 1024 * 1024,
    effectiveTimeoutS: decision.effectiveTimeoutS, timeoutOutcome: decision.timeoutOutcome,
    stopRequested: () => !!rj("stop.json", {}).panic_stop,
    onEvent: (o) => led({ ...o, job_id: job.job_id }),
  });
  let cost = null, sid = null;
  const ok = r.outcome === "SUCCESS";
  try { const o = JSON.parse((r.stdout || "").trim().split("\n").pop()); cost = o.total_cost_usd; sid = o.session_id; } catch { /* */ }
  if (sid) wj(`worker-results/${job.job_id}.session`, { session_id: sid });
  led({ evt: "worker_result", job_id: job.job_id, outcome: r.outcome, exit: r.status, success: ok, cost_usd: cost, overflow: r.overflow, escalated: r.escalated, terminated: r.terminated });
  return { outcome: r.outcome, ok, cost, escalated: r.escalated, terminated: r.terminated, spawned: true };
}

async function main() {
  mkdirSync(join(SUP, "worker-results"), { recursive: true });
  mkdirSync(join(SUP, "logs"), { recursive: true });
  const cfg = rj("config.json", { deadline_hours: 9 });
  const cycle = rj("current-cycle.json", null) || { start: nowS(), deadline: nowS() + (cfg.deadline_hours || 9) * 3600 };
  RUN_ID = cycle.run_id || null; // scope all subsequent events to this run
  wj("current-cycle.json", cycle);

  // ATOMIC SINGLETON: refuse to start if a healthy supervisor already holds the
  // lock (prevents the overlapping-supervisor bug). Recovers a genuinely-stale
  // lock. O_EXCL create makes concurrent launches race-safe — only one wins.
  // pidAliveFn lets the lock library re-evaluate liveness for whatever holder it
  // actually reads (closes the TOCTOU where a peer changed the lock underneath).
  const pidAliveFn = (pid) => { try { process.kill(pid, 0); return true; } catch { return false; } };
  const acq = acquireSingleton(LOCK, { pid: process.pid, pgid: process.pid, run_id: cycle.run_id || "run", exact_sha: cycle.blueprint_digest || "sha", nonce: String(cycle.start), deadline: cycle.deadline },
    { now: nowS(), pidAliveFn, stale_interval: 120 });
  if (!acq.acquired) { led({ evt: "singleton_rejected", reason: acq.decision && acq.decision.reason }); process.exit(0); }
  if (acq.recovered) led({ evt: "singleton_recovered_stale", from_pid: acq.recovered });
  const releaseLock = () => { try { releaseSingleton(LOCK, process.pid); } catch { /* */ } };
  process.on("exit", releaseLock);

  wj("lease.json", { supervisor_pid: process.pid, mode: "USER_SESSION_DETACHED", started: nowS(), pgid: process.pid });
  led({ evt: "session_supervisor_start", pid: process.pid, mode: "USER_SESSION_DETACHED", deadline: cycle.deadline, singleton: "acquired" });

  const gate = canEnterRunning(preconditions());
  if (!gate.ok) { wj("state.json", { state: "HOLD_CORRECTABLE", missing: gate.missing }); led({ evt: "precondition_block", missing: gate.missing }); return; }
  wj("state.json", { state: "RUNNING", mode: "USER_SESSION_DETACHED", updated_at: new Date(nowS() * 1000).toISOString() });

  // Startup heartbeat warmup: emit strictly-advancing heartbeats at a regular
  // cadence before any blocking worker, so qualification can observe liveness.
  led({ evt: "warmup_start", warmup_beats: WARMUP_BEATS, interval_ms: HEARTBEAT_INTERVAL_MS });
  for (let k = 0; k < WARMUP_BEATS; k++) { beat(); await sleep(HEARTBEAT_INTERVAL_MS); }
  led({ evt: "warmup_complete", beats: WARMUP_BEATS });

  let cycles = 0;
  for (;;) {
    beat();
    cycles++;
    const ds = deadlineStatus(nowS(), cycle.start, cycle.deadline, DRAIN_MARGIN_S);
    const q = rj("queue.json", { jobs: [] });
    const ready = (q.jobs || []).filter((j) => j.state === "READY");
    const ctx = { ready_jobs: (ds === "DEADLINE_REACHED" || ds === "DRAINING") ? 0 : ready.length,
      all_jobs_terminal: ready.length === 0, refill_candidate_exists: false,
      panic_stop: !!rj("stop.json", {}).panic_stop, deadline_reached: ds === "DEADLINE_REACHED", atomic_work_drained: true };
    const stop = evaluateStop(ctx);
    if (stop.stop) { wj("state.json", { state: stop.state, mode: "USER_SESSION_DETACHED" }); led({ evt: "session_supervisor_stop", state: stop.state, reason: stop.reason }); break; }
    if (ds === "DRAINING") { wj("state.json", { state: "DRAINING" }); led({ evt: "draining" }); break; }
    // Gate real work on activation: the launcher writes handoff.json ONLY after
    // live qualification passes and the decision is consumed. Until then the
    // supervisor holds (beating), so no job runs before qualification.
    const activated = existsSync(join(SUP, "handoff.json"));
    if (ready.length && activated) {
      const job = ready[0];
      const res = await runWorker(job);
      // Outcome -> job state. Only SUCCESS is DONE. A deadline-expired or
      // stop-terminated job is PRESERVED (HELD, not DONE, not restart-counted) so
      // remaining work survives a governed shutdown; every other non-success
      // outcome (timeout/overflow/spawn-error/unknown) is FAILED and fails closed.
      const preserved = res.outcome === "RUN_DEADLINE_EXPIRED" || res.outcome === "TERMINATED_BY_STOP";
      const newState = isDoneOutcome(res.outcome) ? "DONE" : (preserved ? "HELD" : "FAILED");
      const jobs = q.jobs.map((j) => j.job_id === job.job_id
        ? { ...j, state: newState, last_outcome: res.outcome, restart_count: (j.restart_count || 0) + (newState === "FAILED" ? 1 : 0) }
        : j);
      wj("queue.json", { ...q, jobs });
      // HARD DEADLINE: once the run deadline is reached (pre-spawn or mid-worker),
      // STOP scheduling further jobs and enter governed shutdown. Remaining READY
      // jobs are preserved as queued; the original deadline is never extended.
      if (shouldStopScheduling(res.outcome)) {
        wj("state.json", { state: "RUN_DEADLINE_EXPIRED", mode: "USER_SESSION_DETACHED", updated_at: new Date(nowS() * 1000).toISOString() });
        led({ evt: "run_deadline_expired", job_id: job.job_id, pre_spawn: !!res.preSpawn, note: "governed shutdown; remaining jobs preserved; original deadline unchanged" });
        break;
      }
    } else {
      led({ evt: activated ? "idle_cycle" : "awaiting_activation", note: activated ? "no ready job; heartbeat continues" : "jobs gated until activation; heartbeat continues" });
    }
    if (MAX_CYCLES && cycles >= MAX_CYCLES) { led({ evt: "max_cycles_reached", cycles }); break; }
    // Before activation, keep a tight heartbeat cadence so liveness stays fresh.
    await sleep(existsSync(join(SUP, "handoff.json")) ? CYCLE_SLEEP_MS : HEARTBEAT_INTERVAL_MS);
  }
}
main().catch((e) => { led({ evt: "session_supervisor_error", error: String(e) }); process.exit(1); });

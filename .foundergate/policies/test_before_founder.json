  "policy_id": "test-before-founder",
  "version": "1.1.0",
  "title": "Test Before Founder (TBF-1)",
  "evaluation_class": true,
  "unknown_behavior": "FAIL_CLOSED",
  "stale_behavior": "NOT_CURRENT",
  "core_law": "Before the founder is asked to witness, accept, sign, review or interact with a change, Terminal-0 must exhaust every applicable machine-verifiable check and seal the evidence to disk. Missing required evidence blocks founder readiness. UNKNOWN is not PASS. STALE is not current. A builder's statement is not independent verification. Founder involvement is reserved for human perception, usability judgment, signatures, legal or commercial authority, live-action authorization and other decisions that cannot be mechanically derived.",

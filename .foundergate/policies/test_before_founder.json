  "foreground_founder_surface": {
    "version": "FFS-1",
    "required_for": "every founder-facing UI change or witness candidate",
    "rule": "Before the founder is involved, one full foreground-visible browser run must complete through the same launcher, browser, route and DOM interaction path the founder will use. headless=false alone is insufficient: the window must be visibly rendered, frontmost, onscreen, not minimized, on the active logged-in Mac session, using the configured founder browser, launched through the real launcher, and operated through actual DOM controls. Internal/unit/mutation/API/CI tests may be headless; the final pre-founder surface qualification may not. Headless exact-SHA CI remains separately required and is not interchangeable with foreground proof.",
    "founder_browser": "Google Chrome",
    "states": [
      "NOT_REQUIRED",
      "REQUIRED_NOT_STARTED",
      "FOREGROUND_TEST_RUNNING",
      "FOREGROUND_TEST_FAILED",
      "FOREGROUND_TEST_BLOCKED",
      "FOREGROUND_TEST_VERIFIED"
    ],
    "only_satisfying_state": "FOREGROUND_TEST_VERIFIED",
    "required_evidence": [
      "real_launcher_used",
      "configured_founder_browser",
      "headless_false",
      "browser_process_identity",
      "visible_window_count",
      "frontmost",
      "minimized_false",
      "onscreen_position",
      "window_dimensions",
      "active_gui_session",
      "ui_contract",
      "candidate_sha",
      "dom_transcript",
      "screenshot_sequence",
      "continuous_video",
      "playwright_trace",
      "console_log",
      "network_log",
      "page_error_log",
      "download_evidence_where_applicable",
      "final_dom_assertions",
      "independent_checker_verdict"
    ],
    "machine_profile": ".foundergate/machine_profiles/mac-mini-pro-founder-surface.json",
    "stop_value": "TBF-HOLD: FOREGROUND-FOUNDER-SURFACE-NOT-VERIFIED",
    "completion_invariant": "A Safety Check requiring an Evidence Pack may not display COMPLETE, DONE or a founder witness candidate while the Evidence Pack is UNKNOWN, MISSING, FAILED, CORRUPT, STALE or NOT-PASSED. Only COMPLETE_WITH_VERIFIED_EVIDENCE_PACK may expose a completed witness candidate, Evidence Pack AVAILABLE, and the Download action."
  },
  "cto_prompt_law": {
    "steps": [
      "locate_active_policy_from_disk",
      "verify_digest",
      "record_version_in_lane_contract",
      "classify_task_impacts",
      "load_machine_founder_surface_profile_and_derive_foreground_obligation",
      "derive_required_tests",
      "refuse_if_missing_corrupt_or_unknown",
      "write_all_evidence_to_disk",
      "validate_witness_readiness_before_founder"
    ],
    "stop_value": "TBF-HOLD: ACTIVE-POLICY-MISSING-OR-INVALID"
  },
  "authorization": {

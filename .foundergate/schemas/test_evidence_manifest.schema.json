{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TBF-1 Test Evidence Manifest",
  "type": "object",
  "required": ["lane_id", "candidate_sha", "policy_version", "policy_digest",
               "impact_classes", "tests"],
  "properties": {
    "lane_id": {"type": "string"},
    "candidate_sha": {"type": "string"},
    "policy_version": {"type": "string"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "impact_classes": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {
      "type": "object", "required": ["class", "status"],
      "properties": {
        "class": {"type": "string"},
        "status": {"type": "string", "enum": ["PASS", "FAILED", "UNKNOWN", "STALE",
                                              "NOT_PASSED", "BLOCKED", "MISSING"]},
        "sha": {"type": "string"},
        "command": {"type": "string"},
        "timestamp": {"type": "string"},
        "environment": {"type": "string"},
        "evidence": {"type": "array", "items": {
          "type": "object", "required": ["path"],
          "properties": {"path": {"type": "string"},
                         "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      }}},
    "not_applicable": {"type": "array", "items": {
      "type": "object", "required": ["class", "reason"],
      "properties": {"class": {"type": "string"}, "reason": {"type": "string"}}}},
    "checker": {"type": "object", "properties": {"verdict": {"type": "string"}, "identity": {"type": "string"}}},
    "advisor": {"type": "object", "properties": {"present": {"type": "boolean"}, "verdict": {"type": "string"}}},
    "founder_witness_or_signature": {"type": "boolean"},
    "terminal0_decision_packet": {"type": "boolean"},
    "active_qualification_prohibits_merge": {"type": "boolean"},
    "declared_witness_readiness": {"type": "string"},
    "remaining_limitations": {"type": "array", "items": {"type": "string"}}
  }
}

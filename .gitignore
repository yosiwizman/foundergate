# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
**/secrets.*
*secret*
*credential*
*token*

# Test fixtures are DATA, never real secrets — the pre-commit secret SCAN (not
# this filename glob) is the real guard. Un-ignore test fixtures so legitimately
# named ones (e.g. secrets-absent.fixture.json, which proves a secret is ABSENT)
# are tracked and reach CI.
!**/fixtures/**
!**/*.fixture.json
.npmrc

# --- Private store paths (source-system runtime state; never a dependency here) ---
.akior/
**/.akior/
*.session
sessions/

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log
.pnpm-debug.log*

# --- Local scratch / OS ---
.DS_Store
*.log
tmp/
scratch/
*.local.*

# --- Test / harness churn (local timelines are regenerated, not committed) ---
*.local.jsonl
coverage/
.nyc_output/
